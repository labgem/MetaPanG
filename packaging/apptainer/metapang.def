# Build from the repository root:
#   apptainer build metapang.sif packaging/apptainer/metapang.def
Bootstrap: docker
From: mambaorg/micromamba:latest

%files
    packaging/apptainer/env.yaml /opt/env.yaml
    pyproject.toml /opt/src/pyproject.toml
    README.md /opt/src/README.md
    LICENSE /opt/src/LICENSE
    metapang /opt/src/metapang

%post
    micromamba install -y -n base -f /opt/env.yaml
    micromamba run -n base python -m pip install --no-cache-dir /opt/src
    micromamba clean --all --yes

%environment
    export PATH=/opt/conda/bin:/opt/conda/condabin:$PATH

%runscript
    exec metapang "$@"

%help
    MetaPanG: strain-level metagenomic profiling against pangenome graphs.
    Example: apptainer run metapang.sif profile -q reads.fastq.gz -b GTDB_refseq@2.0.0
